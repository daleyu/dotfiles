#theme
theme = dark:Catppuccin Mocha,light:GitHub Light Default

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

mouse-hide-while-typing = true
macos-titlebar-style=transparent
macos-option-as-alt = left

# font
font-size = 14
adjust-cell-height = 15%
adjust-cell-width = "-3%"
adjust-cell-height = "3%"

# window and toolbar decoration
window-decoration = auto
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = hidden

#styling for transparent
background-opacity = .85
# TODO: add https://github.com/ghostty-org/ghostty/pull/5170 for toggle when it
# is merged
background-blur = 15

# keybindings
keybind = alt+o>r=reload_config
keybind = alt+o>x=close_surface

keybind = alt+o>t=toggle_background_opacity

keybind = alt+o>n=new_window
keybind = alt+kp_add=increase_font_size:1

# tabs 
keybind = alt+o>c=new_tab
keybind = alt+o>shift+l=next_tab
keybind = alt+o>shift+h=previous_tab
keybind = alt+o>comma=move_tab:-1
keybind = alt+o>period=move_tab:1

# quick tab switch
keybind = alt+o>1=goto_tab:1
keybind = alt+o>2=goto_tab:2
keybind = alt+o>3=goto_tab:3
keybind = alt+o>4=goto_tab:4
keybind = alt+o>5=goto_tab:5
keybind = alt+o>6=goto_tab:6
keybind = alt+o>7=goto_tab:7
keybind = alt+o>8=goto_tab:8
keybind = alt+o>9=goto_tab:9

# split
keybind = alt+o>\=new_split:right
keybind = alt+o>-=new_split:down

keybind = alt+o>j=goto_split:bottom
keybind = alt+o>k=goto_split:top
keybind = alt+o>h=goto_split:left
keybind = alt+o>l=goto_split:right

keybind = alt+o>z=toggle_split_zoom

keybind = alt+o>e=equalize_splits

# other
copy-on-select = clipboard


# TMUX settings
keybind = alt+shift+left_bracket=text:\x01\x1b[A
keybind = alt+shift+right_bracket=text:\x01\x1b[B

# Also allow Ctrl+Tab navigation on Linux.
keybind = ctrl+shift+tab=text:\x01\x1b[A
keybind = ctrl+tab=text:\x01\x1b[B

keybind = alt+1=text:\x011
keybind = alt+2=text:\x012
keybind = alt+3=text:\x013
keybind = alt+4=text:\x014
keybind = alt+5=text:\x015
keybind = alt+6=text:\x016
keybind = alt+7=text:\x017
keybind = alt+8=text:\x018
keybind = alt+9=text:\x019
keybind = alt+digit_1=text:\x011
keybind = alt+digit_2=text:\x012
keybind = alt+digit_3=text:\x013
keybind = alt+digit_4=text:\x014
keybind = alt+digit_5=text:\x015
keybind = alt+digit_6=text:\x016
keybind = alt+digit_7=text:\x017
keybind = alt+digit_8=text:\x018
keybind = alt+digit_9=text:\x019

# next tab
keybind = alt+n=text:\x01n
keybind = alt+left_bracket=text:\x00[

# prev tab
keybind = alt+p=text:\x01p

# close tab
keybind = alt+w=text:\x01&

# close pane
keybind = alt+x=text:\x02x

# open sessions
keybind = alt+s=text:\x01s

# workspace / machine navigator
keybind = alt+t=text:\x01m

# running agent navigator
keybind = alt+f=text:\x01a

# toggle sidebar
keybind = alt+b=text:\x01b

# visual mode
keybind = alt+y=text:\x01[

# go to last session
keybind = alt+l=text:\x01L

# rename window
keybind = alt+r=text:\x01,

# Herdr GoTo
keybind = alt+g=text:\x01g
